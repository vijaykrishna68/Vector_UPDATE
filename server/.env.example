# Vector Scheduler — server environment variables.
# Copy to `.env` in this directory and fill in real values. Never commit `.env`.

# --- Required -----------------------------------------------------------
# MongoDB connection string. The server exits at startup if this is missing
# or unreachable (see db.js) — nothing is served, including the frontend,
# until this connects.
MONGODB_URI=mongodb://127.0.0.1:27017/vector

# --- Recommended for production -----------------------------------------
# Enables fail-closed CORS (same-origin only) and other production behavior.
# Most hosting platforms set this automatically; confirm it either way.
NODE_ENV=production

# --- Optional: networking -------------------------------------------------
# Port the server listens on. Most PaaS platforms inject this themselves;
# leave unset unless self-hosting on a bare VM. Defaults to 4000.
PORT=4000

# Comma-separated allowlist of origins permitted to call the API cross-origin,
# e.g. https://app.example.com,https://admin.example.com
# Only needed when the frontend is hosted on a DIFFERENT origin than this
# server. For the standard single-service deployment (Express serves the
# built frontend from the same origin), leave this unset — CORS then fails
# closed to same-origin requests only, which is what same-origin needs.
# CORS_ORIGIN is accepted as an alias for this variable.
CORS_ORIGINS=

# --- Optional: upload limits (safe defaults already in code) -------------
# Maximum accepted upload size, in bytes. Defaults to 26214400 (25 MB).
MAX_UPLOAD_BYTES=26214400

# Maximum uploads allowed per client within the rate-limit window. Default 20.
UPLOAD_RATE_MAX=20

# Rate-limit window, in milliseconds. Default 900000 (15 minutes).
UPLOAD_RATE_WINDOW_MS=900000

# --- Optional: allocation engine override ---------------------------------
# Force the name of the "working days" sheet instead of auto-detecting it by
# its "Working Days As Per Plan" header (see CLAUDE.md, BUG-3). Leave unset
# for normal operation; only set this if a specific workbook's sheet cannot
# be identified automatically.
WORKING_DAYS_SHEET=
