# Only needed when the backend is hosted on a DIFFERENT origin than this app.
# In production the Express server serves this build from its own origin, and in
# development vite.config.js proxies /upload, /allocation and /health to the
# backend, so this can normally be left unset.
# VITE_API_URL=https://your-backend.example.com

# Override the dev proxy target if the backend does not run on port 4000.
# VITE_DEV_API_TARGET=http://localhost:4000
